<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion><AssemblyName>WindowsUse</AssemblyName>
    <PackageJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../package.json'))</PackageJson>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(PackageJson), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType><Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" /><Reference Include="System.Security" />
  </ItemGroup>
</Project>
